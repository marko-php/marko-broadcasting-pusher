{
    "name": "marko/broadcasting-pusher",
    "description": "Pusher-protocol broadcasting driver for Marko Framework (Pusher, Soketi, Laravel Reverb)",
    "type": "marko-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "marko/clock": "self.version",
        "marko/authentication": "self.version",
        "marko/broadcasting": "self.version",
        "marko/config": "self.version",
        "marko/core": "self.version",
        "marko/http": "self.version",
        "marko/routing": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Marko\\Broadcasting\\Pusher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marko\\Broadcasting\\Pusher\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
